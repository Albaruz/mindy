{
  "fontFamily": {
    "base": "var(--font-inter, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif)",
    "display": "var(--font-display, Georgia, \"Times New Roman\", serif)",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
  },
  "fontSize": {
    "2xs": "0.625rem",
    "xs": "0.75rem",
    "sm": "0.8125rem",
    "base": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "2xl": "1.375rem",
    "3xl": "1.5rem",
    "4xl": "1.75rem",
    "5xl": "2.25rem"
  },
  "fontWeight": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "black": 800
  },
  "lineHeight": {
    "none": 1,
    "tight": 1.15,
    "snug": 1.375,
    "base": 1.5,
    "relaxed": 1.625
  },
  "letterSpacing": {
    "tight": "-0.02em",
    "normal": 0,
    "wide": "0.02em"
  }
}