# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* vars ship to the browser; the rest stay server-only.

# Canonical production origin (no trailing slash). Used for security
# URLs (password recovery). Required in production; dev falls back
# to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public anon pair; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never prefix with NEXT_PUBLIC_
GROQ_API_KEY=
OPENWEATHER_API_KEY=
